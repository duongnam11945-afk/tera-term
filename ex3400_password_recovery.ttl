newpass = 'XXX'

messagebox 'Hay RUT NGUON VA CAM LAI Switch, sau do bam OK!' 'Bat dau'

timeout = 180
wait 'press Ctrl-C'
send #3

timeout = 30
wait 'Choice:'
sendln '5'

wait 'Choice:'
sendln '2'

timeout = 360
wait 'root>'

pause 2
sendln 'configure'
wait '#'

sendln 'set system root-authentication plain-text-password'
wait 'New password:'
sendln newpass

wait 'Retype new password:'
sendln newpass

wait '#'


sendln 'commit'

wait 'commit complete'

sendln 'exit'
wait '>'

sendln 'request system reboot'
wait '[yes,no]'
sendln 'yes'

messagebox 'DA RESET MAT KHAU THANH CONG!' 'Hoan tat'
end