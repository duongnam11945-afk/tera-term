; ==============================================================================
; SCRIPT RECOVERY CHO JUNIPER EX3400 (TU DONG SPAM CTRL+C DE EP DUNG BOOT)
; ==============================================================================

newpass = 'Vtv@210689'

messagebox 'Hay RUT NGUON VA CAM LAI Switch, sau do bam OK NGAY!' 'Chuan bi'

; --- BƯỚC 1: SPAM LIÊN TỤC CTRL+C TRONG 30 GIÂY ĐẦU ĐỂ BẮT MENU ---
; Gửi mã #3 (Ctrl+C) mỗi 0.5 giây để ép switch dừng autoboot
timeout = 1
for i 1 60
    send #3
    mpause 500
next

; --- BƯỚC 2: ĐIỀU HƯỚNG MENU RECOVERY ---
timeout = 60
wait 'Choice:'
sendln '5'

wait 'Options Menu'
wait 'Choice:'
sendln '2'

; --- BƯỚC 3: CHỜ NẠP VÀO CLI RECOVERY (Mất tầm 2-4 phút) ---
timeout = 360
wait 'root>'
if result == 0 then
    messagebox 'Khong vao duoc giao dien root> CLI.' 'Loi'
    end
endif

; --- BƯỚC 4: TỰ ĐỘNG ĐỔI MẬT KHẨU ---
pause 2
sendln 'configure'

wait '#'
sendln 'set system root-authentication plain-text-password'

wait 'New password:'
sendln newpass

wait 'Retype new password:'
sendln newpass

wait '#'
sendln 'commit'

wait '#'
sendln 'exit'

wait 'root>'
sendln 'request system reboot'

wait '[yes,no]'
sendln 'yes'

messagebox 'Da reset mat khau thanh cong! Switch dang reboot binh thuong.' 'Thanh cong'
end